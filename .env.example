# Optional GHL-to-Slack reporting utility only.
# The public LayerEngine website is static and does not use these variables.
# Never commit a populated .env file.

# GoHighLevel private integration token with only the required access.
GHL_PRIVATE_TOKEN=

# GoHighLevel sub-account / location ID.
GHL_LOCATION_ID=

# GoHighLevel pipeline ID used for the stage-by-stage report.
GHL_PIPELINE_ID=

# Slack incoming-webhook URL for delivery of the report.
SLACK_WEBHOOK_URL=

# Optional: reporting window in days. Defaults to 365 when omitted.
DAYS_BACK=365
